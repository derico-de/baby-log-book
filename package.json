	"description": "A shared, offline-first log of a baby's day, self-hosted by the people who keep it",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@11.22.0",
	"bin": {
		"babylog": "./bin/babylog.js"
	},
	"scripts": {
