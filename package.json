		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24.0.0",
		"dexie": "^4.4.5",
		"fake-indexeddb": "^6.0.0",
		"fflate": "^0.8.3",
		"jsdom": "^30.0.1",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
