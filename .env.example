# Copy to .env for local development. Vite loads .env automatically, so
# `npm run dev` then needs no inline environment.

# The address you actually open in the browser, with no trailing slash. Claim
# Links are built from it, so point it at the host you browse from — use
# http://localhost:5173 for a local-only dev server, or the machine's hostname
# when you reach the dev server from a phone on the same network.
ORIGIN=http://localhost:5173

# Keeps the SQLite file, backups and session key out of /data in dev.
DATA_DIR=./.data
